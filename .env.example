# ---------------------------------------------------------------
#  Arbitrage Sourcing Engine — configuration
#  Copy this file to ".env" and fill in your Keepa key.
# ---------------------------------------------------------------

# REQUIRED. Get one at keepa.com (API section).
# Without this the Amazon side cannot run and ROI stays modelled.
KEEPA_API_KEY=

# Amazon marketplace. 1 = amazon.com (US)
KEEPA_DOMAIN=1

# ---- Your sourcing criteria -----------------------------------
MIN_ROI=30            # minimum return on investment, percent
MIN_PROFIT=3.00       # minimum net profit per unit, dollars
MAX_BSR=250000        # ignore products ranked worse than this
MAX_OFFER_COUNT=15    # ignore listings this crowded

# ---- Your costs -----------------------------------------------
INBOUND_COST=0.55     # shipping per unit into Amazon
PREP_COST=0.00        # prep / labelling per unit
